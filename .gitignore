# Python
__pycache__/

# Firebase Service Account — written by CI deploy from GitHub Secret.
# Touched as an empty file in dev runs so docker-compose bind mount
# resolves; never commit real credentials.
firebase-admin.json
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Django
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment
.env
.env.*
!.env.example
!.env.*.example
*.env.local

# Secrets — MCP server config contains plaintext API tokens
.mcp.json
!.mcp.json.example

# Sensitive files (W0-X1 denylist) — credential-bearing filenames that
# must never enter git even if entropy scanning would not flag them.
# Placeholder templates keep an explicit `.example` suffix.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*firebase-adminsdk*.json
*service-account*.json
*service_account*.json
credentials.json
client_secret*.json
!*.example

# Claude Code local settings
.claude/settings.local.json

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS
.DS_Store
Thumbs.db

# Office / LibreOffice lock files
.~lock.*#

# Binary business artifacts (PRDs, models, reports — not source)
*.pdf
*.xlsx
*.docx
*.zip

# Figma exports
figma-screens/

# Distribution
*.egg-info/
dist/
build/

# Test logs
test_results.log
tests/integration_results.log
