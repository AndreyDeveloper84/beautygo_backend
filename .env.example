DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=False

# Environment label — gates fail-fast strictness in djangoProject/settings/
# prod.py. Only DJANGO_ENV=production raises ImproperlyConfigured on missing
# OAuth / YooKassa env; staging / dev / anything else downgrades to a logged
# warning so a partially-provisioned environment can still boot. Default in
# code is "production" (fail-closed) — set this to "staging" on dev VPS
# environments that mirror prod settings but don't yet have real OAuth.
DJANGO_ENV=production

# Minio / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=beautygo-media

# Social auth provider audiences. Required in prod (settings/prod.py
# raises ImproperlyConfigured at import if missing) — without them
# Google/Apple id-token audience claims are silently skipped, opening
# a cross-OAuth-client account-takeover path.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AGENT_ID=

# YooKassa webhook source allowlist. Comma-separated CIDRs / single IPs
# permitted to POST /api/v1/payments/webhook/. YooKassa publishes its
# source ranges at https://yookassa.ru/developers/using-api/webhooks —
# copy the current list here. Required in prod (prod.py fail-fast).
YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.154.128/25,77.75.156.11,77.75.156.35,2a02:5180::/32

# Number of trusted reverse proxies in front of Django (typically 1 = nginx).
# The IP allowlist consults X-Forwarded-For at depth N from the right; with
# fewer than N entries it falls back to REMOTE_ADDR. Misconfiguring either
# lets attackers spoof XFF (too high) or rejects legitimate traffic (too low).
# Default 1 is correct for the standard nginx -> Django setup; set to 2 only
# if there's a CDN in front of nginx.
YOOKASSA_WEBHOOK_TRUSTED_PROXY_COUNT=1

# Observability — Sentry + structured logging.
# Empty SENTRY_DSN leaves the SDK no-op (acceptable in dev / CI).
# In prod, populate from https://sentry.io project settings.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional release id (git SHA injected by deploy). Empty = "unknown release".
SENTRY_RELEASE=

# Logging
# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR. INFO is the prod default.
# LOG_FORMAT: "human" (dev — readable plaintext) or "json" (prod — line-per-event,
# parseable by logs aggregators). prod.py forces "json" regardless of env.
LOG_LEVEL=INFO
LOG_FORMAT=human

# Async tasks — Celery + Redis.
# Production / dev VPS docker-compose runs Redis as a sibling service,
# `redis://redis:6379` from the perspective of the web container.
# Local plain-pytest runs use settings.test which overrides cache to
# LocMem and forces CELERY_TASK_ALWAYS_EAGER, so REDIS_URL is not
# required for the default test path.
REDIS_URL=redis://localhost:6379
# Set CELERY_TASK_ALWAYS_EAGER=False locally to test real async flow
# (requires a worker process).
CELERY_TASK_ALWAYS_EAGER=False

# OpenAI / LLM. api.openai.com is geo-blocked from RU since Feb 2024, so
# deployed environments must tunnel through OPENAI_PROXY (HTTP/SOCKS proxy
# with a non-RU exit IP — residential preferred so OpenAI's anti-abuse
# doesn't flag the IP). OPENAI_BASE_URL is optional and only used when
# routing through an OpenAI-compatible gateway like ProxyAPI.ru.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PROXY=
OPENAI_MODEL=gpt-4o-mini
