# Django
# REQUIRED. settings/prod.py refuses to boot when this is missing, blank or
# starts with 'django-insecure-' (the development fallback / startproject
# shape), whatever DJANGO_ENV says.
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DJANGO_SETTINGS_MODULE=djangoProject.settings.prod
DJANGO_ALLOWED_HOSTS=dev.gobeauty.site,194.87.99.126
# production (strict) or staging (pilot). Both now REQUIRE the OAuth client
# ids and the MinIO credentials below; the OTP dev-code flag must stay off
# (it is refused at boot with this settings profile).
DJANGO_ENV=production
OTP_FIXED_DEV_CODE_ENABLED=false

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://dev.gobeauty.site

# PostgreSQL (shared by Django and the postgres container)
POSTGRES_DB=specialist_marketplace
POSTGRES_USER=beautygo_user
# REQUIRED - docker-compose.yml has no default any more.
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO / S3 object storage. REQUIRED on production and staging: no vendor
# default in docker-compose.yml, and settings/prod.py refuses to boot
# without them.
MINIO_ROOT_USER=generate-a-dedicated-access-key
MINIO_ROOT_PASSWORD=generate-a-strong-password-here
MINIO_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=beautygo-media

# Social auth OAuth client ids. REQUIRED on production AND staging:
# without them every Google/Apple token is refused (the audience check
# cannot run) and settings/prod.py refuses to boot.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# YooKassa webhook source allowlist (see .env.example for the current
# official ranges). With settings.prod an EMPTY list refuses every webhook
# (403) rather than accepting all sources.
YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.154.128/25,77.75.156.11,77.75.156.35,2a02:5180::/32

# Visit completion sweep (DRF-1064 / DRF-1048). Inert until BOTH
# ENABLED=true and NOT_BEFORE are set — see .env.example for the full
# rationale and for the backlog command that drains anything older than
# the floor. Enabling is an owner decision, not a deploy detail: the
# first tick after it charges platform fees and sends review requests
# for everything it closes.
BOOKING_AUTO_COMPLETE_ENABLED=false
BOOKING_AUTO_COMPLETE_NOT_BEFORE=
BOOKING_AUTO_COMPLETE_AFTER_HOURS=3
# DRF-1852 (OD-V2): window, in hours after completed_at, for the operator
# correction completed -> no_show (manage.py correct_completion_to_no_show).
BOOKING_COMPLETION_CORRECTION_WINDOW_HOURS=24

# Food photo purge (DRF-1843, §134/§135). The daily beat task counts and
# reports expired photos regardless; this flag gates the irreversible
# deletion — owner decision. See .env.example for the log line to read
# and the dry-run command. Takes effect after a celery_worker restart.
FOOD_PHOTO_PURGE_ENABLED=false

# --- USDA: официальный справочник состава (DRF-2334, DRF-2381) ----------
# Выключен по умолчанию; включение — решение владельца (внешние запросы и
# лимиты). Объявлено явно: переменная, которой нет в контуре, не отличается
# от забытой. Выключенность не молчит — INFO `nutrition.usda.layer_absent
# reason=disabled (USDA_LOOKUP_ENABLED)`; расшифровка четырёх исходов
# журнала и оговорка про отсутствующий словарь названий — в .env.example.
USDA_LOOKUP_ENABLED=false
# Ключ api.data.gov. Пусто при включённом слое — недонастройка, слышна как
# WARNING `reason=not_configured`; скан от неё не падает.
USDA_API_KEY=
