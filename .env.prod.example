# Django
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DJANGO_SETTINGS_MODULE=djangoProject.settings.prod
DJANGO_ALLOWED_HOSTS=dev.gobeauty.site,194.87.99.126

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://dev.gobeauty.site

# PostgreSQL (shared by Django and the postgres container)
POSTGRES_DB=specialist_marketplace
POSTGRES_USER=beautygo_user
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Visit completion sweep (DRF-1064 / DRF-1048). Inert until BOTH
# ENABLED=true and NOT_BEFORE are set — see .env.example for the full
# rationale and for the backlog command that drains anything older than
# the floor. Enabling is an owner decision, not a deploy detail: the
# first tick after it charges platform fees and sends review requests
# for everything it closes.
BOOKING_AUTO_COMPLETE_ENABLED=false
BOOKING_AUTO_COMPLETE_NOT_BEFORE=
BOOKING_AUTO_COMPLETE_AFTER_HOURS=3
